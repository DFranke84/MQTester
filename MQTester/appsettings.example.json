{
  // MQTester settings - EXAMPLE FILE.
  // On first run the app copies this file to appsettings.json (next to MQTester.exe) if that file
  // doesn't exist yet. Put your real servers and credentials in appsettings.json - it is git-ignored
  // so passwords never end up in source control.

  // Each entry shows up in the Environment dropdown. Picking one fills in
  // Host / Port / Channel / Queue Manager and the Queue dropdown list.
  // The fields stay editable, so you can still type a one-off value.
  // "UseDefaultCredentials": true  -> uses the MQDefaultCredentials below
  // "UseDefaultCredentials": false -> uses this entry's own Username / Password (blank = none sent)
  "MQEnvironments": [
    {
      // Matches the defaults of IBM's MQ developer container (icr.io/ibm-messaging/mq)
      "Name": "Local developer QM (QM1)",
      "Host": "127.0.0.1",
      "Port": 1414,
      "Channel": "DEV.APP.SVRCONN",
      "QueueManager": "QM1",
      "Queues": [ "DEV.QUEUE.1", "DEV.QUEUE.2", "DEV.QUEUE.3" ],
      "UseDefaultCredentials": false,
      "Username": "app",
      "Password": ""
    },
    {
      "Name": "Example - TEST server",
      "Host": "mq-test.example.com",
      "Port": 1414,
      "Channel": "APP.SVRCONN",
      "QueueManager": "QM.TEST",
      "Queues": [ "APP.REQUEST.QL", "APP.REPLY.QL" ],
      "UseDefaultCredentials": true
    },
    {
      "Name": "Example - SIT server",
      "Host": "mq-sit.example.com",
      "Port": 1415,
      "Channel": "APP.SVRCONN",
      "QueueManager": "QM.SIT",
      "Queues": [ "APP.REQUEST.QL", "APP.REPLY.QL" ],
      "UseDefaultCredentials": true
    }
  ],

  // Shared login for environments with "UseDefaultCredentials": true
  "MQDefaultCredentials": {
    "Username": "your-mq-user",
    "Password": ""
  },

  "NLog": {
    "targets": {
      "logfile": {
        "type": "File",
        "fileName": "logs/logfile.txt",
        "layout": "${longdate} ${uppercase:${level}} ${message} ${exception}"
      }
    },
    "rules": [
      {
        "logger": "*",
        "minLevel": "Info",
        "writeTo": "logfile"
      }
    ]
  }
}
